{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "sar-express",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/sar-express.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
